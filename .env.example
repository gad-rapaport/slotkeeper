# Copy to .env (scripts/ops.ps1 setup does this and fills in random values). Never commit .env.

# PostgreSQL password for the container database. Letters and digits only.
POSTGRES_PASSWORD=replace-with-random-value

# Demo account passwords used by the seed (at least 12 characters each).
SEED_ADMIN_PASSWORD=replace-with-random-value
SEED_MEMBER_PASSWORD=replace-with-random-value

# Booking creations per user per minute (the concurrency simulation raises this temporarily).
BOOKING_RATE_LIMIT_PER_MINUTE=30

# ---- Local development outside Docker only (npm run dev:server) ----
# DATABASE_URL=postgres://slotkeeper:<POSTGRES_PASSWORD>@127.0.0.1:54103/slotkeeper
# DEV_ORIGIN=http://127.0.0.1:5183
# OPENAPI_PATH=docs/openapi.yaml
# TEST_DATABASE_URL=postgres://slotkeeper:<POSTGRES_PASSWORD>@127.0.0.1:54103/postgres
